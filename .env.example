# INMinut Mobile Frontend Environment Variable Template
# Copy this file to .env and configure for your local environment.
# DO NOT ADD PRIVATE KEYS, DATABASE CREDENTIALS, OR SERVER SECRETS TO FRONTEND ENV FILES.

# Backend API URL (Use 10.0.2.2:5000 for Android emulator, localhost:5000 for iOS simulator, or your local LAN IP for physical device)
EXPO_PUBLIC_API_URL=https://api.inminut.com
